[Unit]
Description=Verify and start the separately released workload
ConditionKernelCommandLine=ada-image.workload_sha256
Requires=docker.service ada-image-ready.service
After=docker.service ada-image-ready.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/ada-image/load-workload
WorkingDirectory=/
StandardOutput=journal+console
StandardError=journal+console
LimitCORE=0
TimeoutStartSec=300
UMask=0077

[Install]
WantedBy=multi-user.target
