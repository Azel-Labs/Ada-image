[Unit]
Description=Check ada-image runtime and immutable root
Requires=docker.service
After=docker.service
Before=ada-image-workload.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/ada-image/check-runtime
StandardOutput=journal+console
StandardError=journal+console
LimitCORE=0

[Install]
WantedBy=multi-user.target
