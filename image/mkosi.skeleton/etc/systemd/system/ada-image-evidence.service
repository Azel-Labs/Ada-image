[Unit]
Description=Export requested public TDX boot evidence to serial port 2
ConditionPathExists=/sys/firmware/acpi/tables/CCEL
Requires=ada-image-ready.service
Wants=network-online.target
After=ada-image-ready.service network-online.target
Before=ada-image-workload.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/ada-image/export-evidence
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=120
UMask=0077
LimitCORE=0

[Install]
WantedBy=multi-user.target
